// clang-format off
#ifndef INC_SOFTWARE_VERSION_H
#define INC_SOFTWARE_VERSION_H

enum : uint8_t {
    kFirmwareVersionSize = 7U,  ///< Maximum size of the firmware version string
    kCommitHashSize = 7U,       ///< Maximum size of the Git commit hash code
};

// NOLINTBEGIN (-Wexcess-initializers)
static constexpr char kGitCommitHash[kCommitHashSize + 1U] = "@COMMIT_HASH@";  ///< Short hash code of the latest git commit
static constexpr char kFirmwareVersion[kFirmwareVersionSize + 1U] = "@PROJECT_VERSION@";  ///< Firmware version set in CMake
// NOLINTEND

// clang-format on
#endif
